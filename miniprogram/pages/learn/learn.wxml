<view class="page">
  <view class="page-body page-body-with-bar">
    <state-view wx:if="{{state === 'loading'}}" state="loading"></state-view>

    <state-view wx:elif="{{state === 'error'}}" state="error" kind="{{errorKind}}" bind:action="onRetry"></state-view>

    <view wx:elif="{{state === 'finished'}}" class="finished">
      <view class="finished-title">{{finishedTitle}}</view>
      <view class="finished-sub t-sub">{{finishedSub}}</view>
      <view class="btn btn-primary finished-primary" bindtap="onReviewToday">现在复习</view>
      <view class="btn-text" bindtap="onBackToCalendar">回到日历</view>
    </view>

    <block wx:else>
      <view class="progress-row">
        <view class="progress-track">
          <view class="progress-bar" style="width: {{progressPercent}}%"></view>
        </view>
        <view class="progress-text t-sub t-num">{{index + 1}} / {{batchSize}}</view>
      </view>

      <word-card
        word="{{current}}"
        revealed="{{revealed}}"
        show-reveal="{{revealHint}}"
        bind:reveal="onReveal"
      ></word-card>
    </block>
  </view>

  <view wx:if="{{state === 'ready'}}" class="action-bar">
    <view class="btn btn-secondary {{index === 0 ? 'btn-disabled' : ''}}" bindtap="onPrev">上一个</view>
    <view class="btn btn-primary" bindtap="onNext">{{index + 1 === batchSize ? '学完了，去复习' : '下一个'}}</view>
  </view>
</view>
