.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.progress-track {
  flex: 1;
  height: 4rpx;
  background: var(--c-bg-subtle);
  border-radius: 2rpx;
}

.progress-bar {
  height: 4rpx;
  background: var(--c-brand);
  border-radius: 2rpx;
  transition: width 150ms ease-out;
}

.progress-text {
  margin-left: 16rpx;
  min-width: 96rpx;
  text-align: right;
}

.finished {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.finished-title {
  font-size: 40rpx;
  font-weight: 600;
}

.finished-sub {
  margin-top: 8rpx;
}

.finished-primary {
  width: 400rpx;
  margin-top: 64rpx;
}
