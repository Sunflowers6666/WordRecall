.profile-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--c-brand-tint);
  color: var(--c-brand);
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.profile-hint {
  margin-top: 8rpx;
}

.login-btn {
  margin-top: 32rpx;
  width: 320rpx;
  height: 88rpx;
}

.profile-list {
  margin-top: 24rpx;
  padding: 0;
  overflow: hidden;
}
