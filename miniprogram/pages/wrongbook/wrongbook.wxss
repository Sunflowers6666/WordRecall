.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  gap: 8rpx;
}

.empty-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.head-num {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--c-danger-strong);
  line-height: 1.1;
}

.list {
  margin-top: 24rpx;
  padding: 0;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  border-bottom: 1rpx solid var(--c-line);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-word {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.row-meaning {
  margin-top: 2rpx;
  font-size: 26rpx;
  color: var(--c-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.start-btn {
  flex: 1;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.review-title {
  font-size: 32rpx;
  font-weight: 700;
}

.progress-track {
  height: 4rpx;
  background: var(--c-bg-subtle);
  border-radius: 2rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.progress-bar {
  height: 4rpx;
  background: var(--c-brand);
  border-radius: 2rpx;
  transition: width 150ms ease-out;
}

.finish-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--c-text-3);
  padding: 16rpx;
}
