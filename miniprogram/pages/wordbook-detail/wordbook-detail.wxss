.head {
  margin-bottom: 24rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-name {
  font-size: 40rpx;
  font-weight: 700;
}

.actions {
  margin-top: 24rpx;
}

.sub-actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 8rpx;
}

.text-action {
  font-size: 26rpx;
  color: var(--c-brand-strong);
  padding: 16rpx 8rpx;
  font-weight: 600;
}

.text-action.danger {
  color: var(--c-danger-strong);
}

.list-title {
  font-size: 26rpx;
  color: var(--c-text-3);
  font-weight: 600;
  margin: 8rpx 4rpx 12rpx;
}

.list {
  padding: 0;
  overflow: hidden;
}

.word-name {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.word-meaning {
  margin-top: 2rpx;
  font-size: 26rpx;
  color: var(--c-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  gap: 6rpx;
}

.add-btn {
  flex: 1;
}
