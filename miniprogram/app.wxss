/* 设计令牌 v2：蓝白（百词斩风）+ 厚按钮与硬阴影（多邻国风）。
   见 docs/ui-preview-v2.html 方案 B + A 混搭。页面与组件只引用变量。 */
page {
  --c-bg-page: #F5F7FA;
  --c-bg-card: #FFFFFF;
  --c-bg-subtle: #EDF2F9;
  --c-brand: #2B7FFF;
  --c-brand-strong: #1A6AE0;
  --c-brand-tint: #E9F1FF;
  --c-text: #1F2937;
  --c-text-2: #4B5563;
  --c-text-3: #6B7280;
  --c-text-disabled: #A8B0BC;
  --c-line: #E3EAF3;
  --c-accent: #FF9F1C;
  --c-danger: #F5483B;
  --c-success: #16A34A;

  --s-1: 8rpx;
  --s-2: 16rpx;
  --s-3: 24rpx;
  --s-4: 32rpx;
  --s-5: 40rpx;
  --s-6: 48rpx;
  --s-8: 64rpx;

  --r-card: 32rpx;
  --r-btn: 24rpx;
  --r-chip: 999rpx;
  --r-modal: 32rpx;
  --sh-card: 0 4rpx 0 #E3EAF3;
  --sh-float: 0 12rpx 32rpx rgba(31, 41, 55, 0.10);
  --btn-depth: 6rpx;

  background-color: var(--c-bg-page);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.page-body {
  padding: var(--s-3) var(--s-4);
}

.page-body-with-bar {
  padding: var(--s-3) var(--s-4) 220rpx;
}

.card {
  background: var(--c-bg-card);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  padding: var(--s-4);
  box-sizing: border-box;
}

.divider {
  height: 1rpx;
  background: var(--c-line);
  margin: var(--s-3) 0;
}

/* 文本 */
.t-secondary { color: var(--c-text-2); }
.t-tertiary { color: var(--c-text-3); }
.t-sub { font-size: 28rpx; color: var(--c-text-3); }
.t-caption { font-size: 24rpx; color: var(--c-text-3); }
.t-num { font-variant-numeric: tabular-nums; }
.t-danger { color: var(--c-danger); }

/* 按钮：view 实现，底部加厚边模拟实体按键 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-btn);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
  transition: transform 120ms ease-out, border-bottom-width 120ms ease-out;
}

.btn-primary {
  background: var(--c-brand);
  color: #FFFFFF;
  border-bottom: var(--btn-depth) solid var(--c-brand-strong);
}

.btn-secondary {
  background: var(--c-bg-card);
  color: var(--c-brand);
  border: 2rpx solid var(--c-line);
  border-bottom: var(--btn-depth) solid var(--c-line);
}

.btn-primary:active,
.btn-secondary:active {
  transform: translateY(4rpx);
  border-bottom-width: 2rpx;
}

.btn-disabled {
  background: var(--c-bg-subtle);
  color: var(--c-text-disabled);
  border: 2rpx solid var(--c-line);
  border-bottom-width: 2rpx;
  box-shadow: none;
}

.btn-text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  color: var(--c-brand);
  font-size: 28rpx;
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx var(--s-4) calc(12rpx + env(safe-area-inset-bottom));
  background: var(--c-bg-card);
  border-top: 2rpx solid var(--c-line);
  box-sizing: border-box;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--s-3);
  padding: 16rpx var(--s-4) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--c-bg-card);
  border-top: 2rpx solid var(--c-line);
  box-sizing: border-box;
}

.action-bar .btn {
  flex: 1;
}

/* 列表行 */
.list-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 var(--s-4);
  border-bottom: 1rpx solid var(--c-line);
  box-sizing: border-box;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row-main {
  flex: 1;
  min-width: 0;
}

.list-row-value {
  font-size: 28rpx;
  color: var(--c-text-3);
  margin-left: var(--s-3);
}

.list-row-arrow {
  margin-left: var(--s-2);
  color: var(--c-text-disabled);
  font-size: 32rpx;
}

/* 胶囊标签 */
.pill {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 var(--s-3);
  border-radius: var(--r-chip);
  background: var(--c-brand-tint);
  color: var(--c-brand);
  font-size: 24rpx;
  font-weight: 700;
}
