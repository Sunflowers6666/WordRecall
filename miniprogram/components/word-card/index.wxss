.word-card {
  position: relative;
  background: var(--c-bg-card, #FFFFFF);
  border-radius: var(--r-card, 32rpx);
  box-shadow: var(--sh-float, 0 12rpx 32rpx rgba(31, 41, 55, 0.10));
  padding: var(--s-5, 40rpx);
  min-height: 640rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.word-card-wrong {
  border: 3rpx solid var(--c-danger, #FF4B4B);
}

.wrong-badge {
  position: absolute;
  top: var(--s-3, 24rpx);
  right: var(--s-3, 24rpx);
  padding: 4rpx 16rpx;
  border-radius: var(--r-chip, 999rpx);
  background: var(--c-danger, #FF4B4B);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.spelling {
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 88rpx;
  line-height: 1.15;
  font-weight: 700;
  text-align: center;
  word-break: break-word;
}

.phonetic {
  margin-top: var(--s-2, 16rpx);
  font-size: 28rpx;
  color: var(--c-text-3, #767676);
  text-align: center;
}

.card-divider {
  height: 2rpx;
  background: var(--c-line, #E5E5E5);
  margin: var(--s-5, 40rpx) 0 var(--s-4, 32rpx);
}

.audio-row {
  display: flex;
  justify-content: center;
  margin-top: var(--s-3, 24rpx);
}

.audio-btn {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: var(--r-chip, 999rpx);
  background: var(--c-brand-tint, #E8F8D8);
  color: var(--c-brand-strong, #46A302);
  font-size: 26rpx;
  font-weight: 700;
}

.audio-btn-on {
  background: var(--c-brand, #58CC02);
  color: #FFFFFF;
}

.meaning {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--c-text-2, #5C5C5C);
  white-space: pre-wrap;
  word-break: break-word;
}

.example {
  margin-top: var(--s-6, 48rpx);
}

.example-label {
  font-size: 24rpx;
  color: var(--c-text-3, #767676);
  margin-bottom: var(--s-1, 8rpx);
}

.example-en {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--c-text-2, #5C5C5C);
}

.example-cn {
  margin-top: var(--s-1, 8rpx);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--c-text-3, #767676);
}

.example-empty {
  margin-top: var(--s-1, 8rpx);
  font-size: 24rpx;
  color: var(--c-text-3, #767676);
}

.reveal-box {
  flex: 1;
  min-height: 240rpx;
  border-radius: 20rpx;
  background: var(--c-bg-subtle, #EEEEEE);
  color: var(--c-text-3, #767676);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
